<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.example</groupId>
		<artifactId>commons-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>commons-aws</artifactId>
	<name>commons-aws</name>
	<description>Optional AWS integration for commons, such as reading resources from AWS Secrets Manager</description>
	<properties>
		<testcontainers-floci.version>2.16.1</testcontainers-floci.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>io.awspring.cloud</groupId>
			<artifactId>spring-cloud-aws-starter-secrets-manager</artifactId>
			<exclusions>
				<!-- apache5-client would put Apache HttpClient 5 on the classpath, which
					Spring's RestClient then picks over the JDK client for every HTTP call the
					application makes (including the OAuth2 token request), changing behavior
					such as redirect handling. netty-nio-client is only for async clients. -->
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>apache5-client</artifactId>
				</exclusion>
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<!-- The AWS SDK's HTTP client built on the JDK's HttpURLConnection. -->
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- Floci, an MIT-licensed AWS emulator, with @ServiceConnection support for
				Spring Cloud AWS. LocalStack's current image needs an account auth token. -->
			<groupId>io.floci</groupId>
			<artifactId>spring-boot-testcontainers-floci</artifactId>
			<version>${testcontainers-floci.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
